{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDSeeker",
  "version": "0.1.0",
  "identifier": "com.devson.mdseeker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDSeeker",
        "width": 1100,
        "height": 750,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Devson1024",
    "copyright": "Copyright © 2026 Devson. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Lightweight Windows-first Markdown Viewer",
    "longDescription": "MDSeeker is a blazing-fast, Windows-first Markdown viewer featuring native Fluent design, syntax highlighting, Mermaid diagrams, KaTeX math rendering, and multi-document tab management.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown formatted document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ]
  }
}
